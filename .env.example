# Copiar este archivo a .env y completar con los valores reales.
# .env NO se sube a git (ver .gitignore).

# --- Supabase / Postgres (Database Settings > Connection string en el dashboard de Supabase) ---
# DATABASE_URL: conexión pooled vía PgBouncer (puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432) — la usa Prisma solo para migraciones.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Mercado Pago (Credenciales de la app en mercadopago.com.ar/developers) ---
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
