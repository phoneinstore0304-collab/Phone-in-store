// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model User {
  id          String              @id @default(cuid())
  // Nullable: el admin puede cargar un cliente a mano (carga manual de
  // clientes/afinidad, brief punto 10) antes de que esa persona se haya
  // registrado. Cuando esa misma persona inicia sesión de verdad con el
  // mismo email, getCurrentUser() "reclama" esta fila (le asigna el
  // clerkId real) en vez de crear un usuario duplicado — ver src/lib/auth.ts.
  clerkId     String?             @unique
  email       String              @unique
  name        String?
  role        Role                @default(CUSTOMER)
  points      Int                 @default(0)
  savePayment Boolean             @default(false)
  tags        String[]
  createdAt   DateTime            @default(now())
  orders      Order[]
  pointsLog   PointsTransaction[]
  tradeInRequests TradeInRequest[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  price       Decimal
  images      String[]
  // true = producto Apple usado (unidad única, se controla con `status`).
  // false = producto sellado de terceros con stock real (se controla con `quantity`).
  isUsed      Boolean       @default(true)
  condition   String? // grado estético: A / B / C, solo aplica si isUsed = true
  status      ProductStatus @default(AVAILABLE)
  quantity    Int?
  // se completa al iniciar un checkout; junto con la constante de expiración
  // de reserva determina cuándo un producto RESERVED vuelve a estar AVAILABLE.
  reservedAt  DateTime?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  createdAt   DateTime      @default(now())
  events      ProductEvent[]
  orderItems  OrderItem[]
  // Variantes de color: productos separados (cada uno con su propia card en
  // el catálogo) que comparten este mismo id arbitrario. `color` es el
  // nombre (ej: "Negro"), `colorHex` es el valor real para pintar el
  // círculo (ej: "#1a1a1a") — se puede tipear a mano o tomar con el
  // selector de "tintero" sobre la primera foto del producto.
  color         String?
  colorHex      String?
  variantGroupId String?

  @@index([variantGroupId])
}

model Promotion {
  id         String   @id @default(cuid())
  title      String
  image      String
  link       String?
  order      Int      @default(0)
  activeFrom DateTime
  activeTo   DateTime
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  total        Decimal
  status       String // pending / paid / cancelled
  mpPaymentId  String?
  shippingInfo Json?
  createdAt    DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal
  quantity  Int     @default(1)
}

model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String?
  sessionId String?
  type      String // VIEW / ADD_TO_CART / PURCHASE
  createdAt DateTime @default(now())
}

model PointsTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  type      String // EARNED / REDEEMED
  orderId   String?
  createdAt DateTime @default(now())
}

// Plan Canje: alguien ofrece su celular usado como parte de pago. Esto es
// un pedido de cotización (la valuación la hace un humano, no hay lógica
// de precios automática todavía) — el admin lo revisa desde /admin/plan-canje
// y contacta al cliente por fuera del sitio.
// Tabla de precios base del cotizador (USD), cargada a mano por el admin a
// medida que se van definiendo valores — ver /admin/plan-canje/precios.
// Si un pedido no encuentra un precio acá para su model+storageGb, queda
// sin cotización automática (TradeInRequest.quotedPriceUsd = null) y se
// cotiza a mano.
model TradeInModelPrice {
  id           String @id @default(cuid())
  model        String
  storageGb    Int
  basePriceUsd Int

  @@unique([model, storageGb])
}

// Plan Canje: alguien ofrece su celular usado como parte de pago. El precio
// se calcula automáticamente a partir de TradeInModelPrice + los ajustes de
// src/lib/trade-in-pricing.ts (batería, caja, detalles estéticos, etc). Si
// tiene alguna rotura o algo no funciona bien, no se cotiza solo: queda
// marcado con needsInPersonReview y lo evalúa un técnico en persona.
model TradeInRequest {
  id     String  @id @default(cuid())
  // Nullable: no hace falta estar logueado para pedir una cotización.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Todos opcionales: se pide la cotización sin dejar datos de contacto si
  // el usuario no quiere — sin al menos uno no lo podemos contactar después,
  // pero eso no bloquea ver el número.
  fullName String?
  phone    String?
  email    String?

  model         String
  storageGb     Int
  batteryHealth Int

  hasOriginalBox Boolean

  // Detalles puramente estéticos (no roturas): cualquiera de estos que sea
  // true resta un monto fijo una sola vez (no se acumulan entre sí).
  hasFrameDetail  Boolean // marco abollado o rayado
  hasBackDetail   Boolean // tapa trasera con rayones o manchas
  hasCameraSmudge Boolean // manchas en el vidrio de la cámara (no roto)
  hasScreenScratch Boolean // rayón leve de pantalla (no rotura)
  cosmeticNotes   String?

  hasRepairs    Boolean // reparación o cambio de algún componente
  repairsDetail String?
  hasWarranty   Boolean
  boughtNew     Boolean // no afecta el precio, solo informativo

  // Cualquiera de estos dos manda el pedido a revisión en persona en vez de
  // cotización automática: roturas de vidrio/pantalla, o algo que no
  // funciona / funciona mal (incluye problemas de la cámara en sí).
  hasBreakage         Boolean
  breakageDetail      String?
  hasFunctionalIssues Boolean
  functionalIssuesDetail String?

  notes String?

  // Snapshot del resultado calculado al momento de crear el pedido (ver
  // calculateTradeInQuote) — no se recalcula después aunque cambien los
  // precios base, para que el admin vea exactamente lo que se le mostró al
  // cliente.
  quotedPriceUsd      Int?
  needsInPersonReview Boolean @default(false)

  // Prueba de que aceptó el disclaimer (cotización estimada, no vinculante,
  // sujeta a inspección física) antes de ver el número — se exige en el
  // formulario con un popup y no se puede armar el pedido sin esto.
  acceptedTermsAt DateTime

  status    String   @default("pending") // pending / contacted / closed
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
}
